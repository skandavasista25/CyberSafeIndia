# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5500

# Database
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/cybersafeindia

# Auth
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Default admin seed (used only by npm run seed:admin)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@cybersafeindia.example
SEED_ADMIN_PASSWORD=ChangeThisPassword123!
